<resources>
    <style name="Theme.POP" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/pop_splash_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.POP.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/pop_logo_official</item>
        <item name="windowSplashScreenBackground">@color/pop_splash_background</item>
        <item name="postSplashScreenTheme">@style/Theme.POP</item>
    </style>
</resources>
