{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL", "DIRECT_DATABASE_URL", "NEXTAUTH_SECRET", "NEXTAUTH_URL", "APP_URL", "PUBLIC_URL", "NEXT_PUBLIC_APP_URL", "NEXT_PUBLIC_WEB_APP_URL",
    "META_ENABLED", "META_APP_ID", "META_APP_SECRET", "META_REDIRECT_URI", "META_OAUTH_CAPABILITIES", "INTEGRATION_TOKEN_ENCRYPTION_KEY",
    "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "R2_ACCOUNT_ID", "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY", "R2_BUCKET_NAME", "R2_ENDPOINT", "R2_PUBLIC_BASE_URL",
    "R2_PUBLIC_FOLDER", "R2_PRIVATE_FOLDER", "MAX_IMAGE_UPLOAD_MB", "ALLOWED_IMAGE_TYPES",
    "NEXT_PUBLIC_FIREBASE_API_KEY", "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN", "NEXT_PUBLIC_FIREBASE_PROJECT_ID", "NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET", "NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID", "NEXT_PUBLIC_FIREBASE_APP_ID", "NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID", "NEXT_PUBLIC_FIREBASE_GUEST_AUTH_ENABLED",
    "FCM_ENABLED", "FCM_PROJECT_ID", "FCM_CLIENT_EMAIL", "FCM_PRIVATE_KEY"
  ],
  "tasks": {
    "dev": { "cache": false, "persistent": true },
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "!.next/cache/**", "dist/**"] },
    "lint": { "dependsOn": ["^lint"] },
    "test": { "dependsOn": ["^build"], "outputs": ["coverage/**"] }
  }
}
