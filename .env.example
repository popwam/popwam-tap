# Authoritative contract and exceptions: docs/POP_ENV_CONTRACT.md
# This file contains placeholders only. Do not load it directly on Railway.

# CORE
# Deployment secrets must be independent, non-placeholder and at least 32 characters.
# CONTACT_MATCH_PEPPER is required only for contact discovery.
BCRYPT_SALT_ROUNDS="12"
CONTACT_MATCH_PEPPER=""
NEXTAUTH_SECRET=""
NODE_ENV="development"

# DATABASE
# Both PostgreSQL URLs are required by deployment tooling; never copy Production into TEST.
DATABASE_URL=""
DIRECT_DATABASE_URL=""

# URLS
# Raw URLs only. NEXT_PUBLIC_APP_URL is the public-site compatibility alias.
# TEST: replace all app origins/hosts with popwam-auth-test-test.up.railway.app
# and all public origins/hosts with popwam-public-test-test.up.railway.app.
# Android uses POPWAM_API_BASE_URL / POPWAM_PUBLIC_BASE_URL at build time.
APP_HOST="pop.popwam.com"
APP_URL="https://pop.popwam.com"
NEXTAUTH_URL="https://pop.popwam.com"
NEXT_PUBLIC_APP_URL="https://go.popwam.com"
NEXT_PUBLIC_WEB_APP_URL="https://pop.popwam.com"
PUBLIC_HOST="go.popwam.com"
PUBLIC_URL="https://go.popwam.com"

# LOCALE
# AR/EN/FR are governed by SystemSetting localization.runtime and locale resources.
# No DEFAULT_LOCALE, SUPPORTED_LOCALES or FALLBACK_LOCALE environment consumer exists.
DEFAULT_PHONE_COUNTRY_ISO2="EG"

# MOBILE SESSION
# POP session secrets are never packaged in Android.
MOBILE_ENROLLMENT_SECRET=""
MOBILE_TOKEN_SECRET=""
SECURITY_SESSION_SECRET=""

# EVOLUTION OTP
# CURRENT PRODUCTION: Evolution variables intentionally absent until Auth deployment.
# CURRENT TEST: complete Evolution group required. Future Production auth preflight:
# node scripts/validate-production-env.mjs --future-auth
# Android sign-in: POP -> Evolution -> WhatsApp -> POP session.
# REVIEW LATER: OTP_EXPIRY_MINUTES / OTP_SEND_COOLDOWN_SECONDS / OTP_HOURLY_SEND_LIMIT
# still govern security step-up, phone-change and Admin SMS testing, not mobile sign-in.
# SMS_*, PHONE_OTP_* and WHATSAPP_* remain referenced there; do not enable them
# for login. Their migration to Evolution is outside this configuration pass.
# ACTIVATION_* protect card claims / QR tokens / rate limits, not OTP delivery.
ACTIVATION_MAX_ATTEMPTS="8"
ACTIVATION_RATE_LIMIT_PEPPER=""
ACTIVATION_SCRATCH_PEPPER=""
ACTIVATION_SESSION_MINUTES="15"
ACTIVATION_TOKEN_PEPPER=""
EVOLUTION_API_KEY=""
EVOLUTION_API_URL=""
EVOLUTION_INSTANCE=""
OTP_EXPIRY_MINUTES="5"
OTP_HOURLY_SEND_LIMIT="5"
OTP_MAX_ATTEMPTS="5"
OTP_PEPPER=""
OTP_RESEND_COOLDOWN_SECONDS="60"
OTP_SEND_COOLDOWN_SECONDS="60"
OTP_TTL_SECONDS="300"
PHONE_OTP_FALLBACK_CHANNEL=""
PHONE_OTP_PRIMARY_CHANNEL=""
PHONE_OTP_TIMEOUT_MS=""
SMS_API_TOKEN=""
SMS_API_URL=""
SMS_ENABLED="false"
SMS_PROVIDER=""
SMS_SENDER_ID=""
SMS_TIMEOUT_MS=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_AUTH_TEMPLATE_LANGUAGE=""
WHATSAPP_AUTH_TEMPLATE_NAME=""
WHATSAPP_OTP_ENABLED="false"
WHATSAPP_PHONE_NUMBER_ID=""

# PASSKEY
# Configure reviewed release signing origins for Production; never copy TEST debug.
# TEST RP/origin must use the isolated API host; approved debug origin is documented
# in docs/POP_ENV_CONTRACT.md. No signing secret belongs here.
PASSKEY_ANDROID_ORIGINS=""
PASSKEY_ORIGIN="https://pop.popwam.com"
PASSKEY_RP_ID="pop.popwam.com"
PASSKEY_RP_NAME="POP by POPWAM"

# MEDIA / R2
# Optional without uploads. Configure the complete public group together.
# R2_PRIVATE_BUCKET_NAME is additionally required for private draft media.
# R2_PUBLIC_BASE_URL is the asset CDN origin, not PUBLIC_URL.
# Leave the entire group absent if storage is disabled; do not copy placeholder URLs.
ALLOWED_FILE_TYPES="application/pdf,text/vcard,text/x-vcard,text/plain,image/jpeg,image/png,image/webp"
ALLOWED_IMAGE_TYPES="image/jpeg,image/png,image/webp"
MAX_FILE_UPLOAD_MB="10"
MAX_IMAGE_UPLOAD_MB="5"
R2_ACCESS_KEY_ID=""
R2_BUCKET_NAME=""
R2_ENDPOINT=""
R2_PRIVATE_BUCKET_NAME=""
R2_PUBLIC_BASE_URL="https://media.popwam.com"
R2_PUBLIC_FOLDER="public"
R2_SECRET_ACCESS_KEY=""

# FCM / FIREBASE
# FCM credentials form an optional complete group; credentials control readiness.
# FCM_ENABLED was not a runtime switch. Web Analytics uses public API/project/app IDs.
# Storage bucket, sender ID and measurement ID are optional SDK metadata; no Auth domain.
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""
FCM_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""

# OPTIONAL CONNECTED ACCOUNTS
# Disabled provider credentials may be absent. Enabled providers require their own
# ID/key, secret, redirect URI and INTEGRATION_TOKEN_ENCRYPTION_KEY.
# META_* is connected accounts; WHATSAPP_* above is the unresolved legacy delivery path.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_ENABLED="false"
GITHUB_REDIRECT_URI=""
GOOGLE_CONNECTED_CLIENT_ID=""
GOOGLE_CONNECTED_CLIENT_SECRET=""
GOOGLE_CONNECTED_ENABLED="false"
GOOGLE_CONNECTED_REDIRECT_URI=""
INTEGRATION_TOKEN_ENCRYPTION_KEY=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_ENABLED="false"
LINKEDIN_REDIRECT_URI=""
META_APP_ID=""
META_APP_SECRET=""
META_ENABLED="false"
META_GRAPH_API_VERSION="v23.0"
META_OAUTH_CAPABILITIES=""
META_REDIRECT_URI=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_ENABLED="false"
TIKTOK_REDIRECT_URI=""

# OPTIONAL WALLET
# Unconfigured supported feature: omit credentials in Railway. Complete signing
# groups are needed only when enabling Wallet; class suffix alone is not activation.
APPLE_WALLET_AUTH_SECRET=""
APPLE_WALLET_ICON_BASE64=""
APPLE_WALLET_PASS_TYPE_ID=""
APPLE_WALLET_SIGNER_CERT_BASE64=""
APPLE_WALLET_SIGNER_KEY_BASE64=""
APPLE_WALLET_SIGNER_KEY_PASSPHRASE=""
APPLE_WALLET_TEAM_ID=""
APPLE_WALLET_WEB_SERVICE_URL=""
APPLE_WALLET_WWDR_CERT_BASE64=""
GOOGLE_WALLET_CLASS_SUFFIX=""
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_WALLET_ISSUER_STATUS=""
GOOGLE_WALLET_MODE="test"
GOOGLE_WALLET_ORIGINS=""
GOOGLE_WALLET_PRIVATE_KEY=""
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=""

# OPTIONAL APK DISTRIBUTION
# Supported /download page. Leave absent until website distribution is active.
NEXT_PUBLIC_ANDROID_APK_SIZE=""
NEXT_PUBLIC_ANDROID_APK_URL=""
NEXT_PUBLIC_ANDROID_MIN_VERSION=""
NEXT_PUBLIC_ANDROID_SHA256=""
NEXT_PUBLIC_ANDROID_UPDATED_AT=""
NEXT_PUBLIC_ANDROID_VERSION=""

# TEST ONLY
# Optional local/automated legacy delivery fixtures ONLY; never live Production.
# Owner Railway TEST acceptance also forbids bypasses: real Evolution delivery only.
# Do not copy these commented settings into normal deployment.
# OTP_EXPOSE_IN_RESPONSE="false"
# OTP_TEST_CODE=""
# OTP_TEST_MODE="false"
# OTP_TEST_PHONES=""
# STAGING="false"

# SEED ONLY
# One-time manual tooling only; not normal build, migrate-deploy or Web startup.
# Supply credentials just for the authorized process; remove after bootstrap.
# ADMIN ensure requires >=12 characters; Production seed passwords require >=16.
# Guards remain false unless explicitly running the corresponding maintenance tool.
# ADMIN_EMAIL=""
# ADMIN_ENSURE_PRODUCTION="false"
# ADMIN_FORCE_PASSWORD_RESET="false"
# ADMIN_PASSWORD=""
# ALLOW_PRODUCTION_ONBOARDING_PROGRESS_REPAIR="false"
# ALLOW_PRODUCTION_ONBOARDING_SEED="false"
# ALLOW_PRODUCTION_SEED="false"
# DEMO_USER_EMAIL=""
# DEMO_USER_PASSWORD=""
