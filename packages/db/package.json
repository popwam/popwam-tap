{
  "name": "@popwam/db",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "scripts": {
    "build": "prisma generate && tsc --noEmit",
    "lint": "prisma validate && tsc --noEmit",
    "prisma": "prisma",
    "generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "seed:onboarding": "tsx prisma/onboarding-definitions.seed.ts",
    "repair": "tsx prisma/repair.ts",
    "backfill:tap-upgrade": "tsx prisma/backfill-tap-upgrade.ts",
    "backfill:pop-upgrade": "tsx prisma/backfill-pop-upgrade.ts",
    "backfill:global-phones": "tsx prisma/backfill-global-phones.ts",
    "backfill:profile-modules:dry-run": "tsx prisma/profile-module-backfill-report.ts",
    "backfill:primary-profile:dry-run": "tsx prisma/primary-profile-candidate-report.ts",
    "backfill:profile-publication:dry-run": "tsx prisma/profile-publication-backfill-report.ts",
    "backfill:activation-secrets:dry-run": "tsx prisma/activation-secret-backfill-report.ts",
    "backfill:security-sessions:dry-run": "tsx prisma/security-session-backfill-report.ts",
    "backfill:friends:dry-run": "tsx prisma/friends-backfill-report.ts",
    "nearby-presence:cleanup:dry-run": "tsx prisma/nearby-presence-cleanup.ts",
    "profile-media:cleanup:dry-run": "tsx prisma/profile-media-cleanup.ts",
    "admin:ensure": "tsx prisma/ensure-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.1",
    "bcryptjs": "^3.0.2",
    "libphonenumber-js": "^1.13.9"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "dotenv": "^17.2.2",
    "prisma": "6.19.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
