model User {
  id                       String                    @id @default(cuid())
  username                 String?                   @unique
  name                     String?
  email                    String                    @unique
  emailVerified            DateTime?
  image                    String?
  passwordHash             String?
  phone                    String?                   @unique
  phoneE164                String?                   @unique
  phoneCountryIso2         String?
  phoneCallingCode         String?
  phoneVerifiedAt          DateTime?
  profession               ProfessionType            @default(PERSONAL)
  customProfession         String?
  backupProvider           BackupProviderType        @default(POP_CLOUD)
  role                     SystemRole                @default(USER)
  status                   AccountStatus             @default(ACTIVE)
  locale                   String?
  shareActivityIdentity    Boolean                   @default(false)
  allowNearbyDiscovery     Boolean                   @default(false)
  defaultSharingCardId     String?
  lastLoginAt              DateTime?
  sessionsRevokedBefore    DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  accounts                 Account[]
  sessions                 Session[]
  profiles                 Profile[]
  destinations             Destination[]
  ownedTags                Tag[]                     @relation("TagOwner")
  organizationsOwned       Organization[]            @relation("OrganizationOwner")
  memberships              Membership[]
  subscriptions            UserPlan[]
  limitOverride            UserLimitOverride?
  profileFields            ProfileField[]
  uploads                  UploadedFile[]            @relation("UploadedBy")
  profileMediaAssets       ProfileMediaAsset[]
  auditLogs                AuditLog[]                @relation("AuditActor")
  ownedCards               Card[]                    @relation("CardOwner")
  createdCardBatches       CardBatch[]               @relation("CardBatchCreator")
  createdProductionBatches ProductionBatch[]         @relation("ProductionBatchCreator")
  assignedProducedTags     ProducedTag[]             @relation("ProducedTagAssignee")
  virtualCards             VirtualCard[]
  tagTransfersFrom         TagTransfer[]             @relation("TagTransferFrom")
  tagTransfersTo           TagTransfer[]             @relation("TagTransferTo")
  onboardingProgress       OnboardingProgress?
  inventoryMovements       InventoryMovement[]       @relation("InventoryMovementCreator")
  createdPurchases         Purchase[]                @relation("PurchaseCreator")
  createdExpenses          Expense[]                 @relation("ExpenseCreator")
  createdOrders            Order[]                   @relation("OrderCreator")
  customer                 Customer?
  activationClaims         ActivationClaimSession[]
  authTickets              AuthTicket[]
  mobileRefreshTokens      MobileRefreshToken[]
  friendshipsA             Friendship[]              @relation("FriendshipUserA")
  friendshipsB             Friendship[]              @relation("FriendshipUserB")
  friendshipRequests       Friendship[]              @relation("FriendshipRequester")
  friendshipBlocks         Friendship[]              @relation("FriendshipBlocker")
  friendRequestsSent       FriendRequest[]           @relation("FriendRequestRequester")
  friendRequestsReceived   FriendRequest[]           @relation("FriendRequestRecipient")
  friendPreferencesOwned   FriendPreference[]        @relation("FriendPreferenceOwner")
  friendPreferencesAbout   FriendPreference[]        @relation("FriendPreferenceFriend")
  friendsPreference        FriendsPreference?
  friendNotifications      FriendNotificationEvent[] @relation("FriendNotificationRecipient")
  friendNotificationActors FriendNotificationEvent[] @relation("FriendNotificationActor")
  privacyRulesOwned        FriendPrivacyRule[]       @relation("PrivacyRuleOwner")
  privacyRulesReceived     FriendPrivacyRule[]       @relation("PrivacyRuleFriend")
  chatMemberships          ChatMember[]
  sentMessages             Message[]
  messageReports           MessageReport[]           @relation("MessageReporter")
  moderatedMessageReports  MessageReport[]           @relation("MessageReportReviewer")
  featureRequests          FeatureRequest[]
  featureVotes             FeatureVote[]
  featureComments          FeatureComment[]
  quotaIncreaseRequests    QuotaIncreaseRequest[]    @relation("QuotaRequestUser")
  reviewedQuotaRequests    QuotaIncreaseRequest[]    @relation("QuotaRequestReviewer")
  contentEntries           ContentEntry[]
  followsCreated           Follow[]                  @relation("FollowFollower")
  followsReceived          Follow[]                  @relation("FollowFollowing")
  blocksCreated            UserBlock[]               @relation("UserBlockOwner")
  blocksReceived           UserBlock[]               @relation("UserBlocked")
  reportsCreated           UserReport[]              @relation("UserReportReporter")
  reportsReceived          UserReport[]              @relation("UserReportSubject")
  moderatedUserReports     UserReport[]              @relation("UserReportReviewer")
  nearbyPreference         NearbyPreference?
  nearbyPresence           NearbyPresence?
  nearbyRateLimitBuckets   NearbyRateLimitBucket[]
  deviceSessions           DeviceSession[]
  productStatusHistory     ProductStatusHistory[]    @relation("ProductStatusActor")
  passkeys                 PasskeyCredential[]
  passkeyChallenges        PasskeyChallenge[]
  connectedAccounts        ConnectedAccount[]
  oauthStates              OAuthConnectionState[]
  devicePushTokens         DevicePushToken[]
  externalIdentities       ExternalIdentity[]
  platformSuggestions      PlatformSuggestion[]
  profileEntitlements      ProfileEntitlement[]      @relation("ProfileEntitlementUser")
  legalConsents            UserLegalConsent[]
  preference               UserPreference?
  notificationPreference   NotificationPreference?
  stepUpGrants             StepUpGrant[]
  accountDeletionRequests  AccountDeletionRequest[]
  mobileAuthChallenges     MobileAuthChallenge[]
  mobileEnrollmentSessions MobileEnrollmentSession[]
  mobileDeviceCredentials  MobileDeviceCredential[]
}

model Plan {
  id                       String     @id @default(cuid())
  name                     String
  nameAr                   String?
  nameEn                   String?
  slug                     String     @unique
  description              String?
  descriptionAr            String?
  descriptionEn            String?
  isActive                 Boolean    @default(true)
  sortOrder                Int        @default(0)
  maxProfiles              Int        @default(1)
  maxVirtualCards          Int        @default(1)
  maxLinks                 Int        @default(5)
  maxCustomFields          Int        @default(3)
  maxTags                  Int        @default(1)
  maxCards                 Int        @default(1)
  maxUploads               Int        @default(0)
  maxFiles                 Int        @default(0)
  maxStorageBytes          BigInt     @default(0)
  allowCustomSlug          Boolean    @default(false)
  customSlugAllowed        Boolean    @default(false)
  allowThemes              Boolean    @default(false)
  allowCustomTheme         Boolean    @default(false)
  allowAnalytics           Boolean    @default(false)
  analyticsAllowed         Boolean    @default(false)
  availableProfileTypes    Json?
  availableThemes          Json?
  allowFileUploads         Boolean    @default(false)
  allowCustomIcons         Boolean    @default(false)
  allowBusinessCards       Boolean    @default(false)
  allowWalletPasses        Boolean    @default(false)
  allowCustomLinks         Boolean    @default(false)
  allowInstallableProfiles Boolean    @default(false)
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
  subscriptions            UserPlan[]
}

model UserPlan {
  id        String             @id @default(cuid())
  userId    String
  planId    String
  status    SubscriptionStatus @default(ACTIVE)
  startsAt  DateTime           @default(now())
  endsAt    DateTime?
  adminNote String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([planId])
}

model UserLimitOverride {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  maxProfiles              Int?
  maxVirtualCards          Int?
  maxLinks                 Int?
  maxCustomFields          Int?
  maxTags                  Int?
  maxCards                 Int?
  maxUploads               Int?
  maxFiles                 Int?
  maxStorageBytes          BigInt?
  allowCustomSlug          Boolean?
  customSlugAllowed        Boolean?
  allowThemes              Boolean?
  allowCustomTheme         Boolean?
  allowAnalytics           Boolean?
  analyticsAllowed         Boolean?
  availableProfileTypes    Json?
  availableThemes          Json?
  allowFileUploads         Boolean?
  allowCustomIcons         Boolean?
  allowBusinessCards       Boolean?
  allowWalletPasses        Boolean?
  allowCustomLinks         Boolean?
  allowInstallableProfiles Boolean?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id                  String            @id @default(cuid())
  sessionToken        String            @unique
  userId              String
  expires             DateTime
  deviceSessionId     String?
  authMethod          SessionAuthMethod @default(LEGACY)
  createdAt           DateTime          @default(now())
  lastSeenAt          DateTime          @default(now())
  lastAuthenticatedAt DateTime?
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceSession       DeviceSession?    @relation(fields: [deviceSessionId], references: [id], onDelete: SetNull)
  stepUpGrants        StepUpGrant[]

  @@index([userId, expires])
  @@index([deviceSessionId, expires])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  ownerId      String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  owner        User          @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  memberships  Membership[]
  profiles     Profile[]
  destinations Destination[]
  tags         Tag[]
  cards        Card[]
  cardBatches  CardBatch[]
  virtualCards VirtualCard[]
}

model Membership {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Profile {
  id                   String               @id @default(cuid())
  userId               String
  organizationId       String?
  categoryId           String?
  templateId           String?
  slug                 String?              @unique
  draftSlug            String?
  displayName          String
  displayLabel         String?
  type                 ProfileType          @default(PERSONAL)
  profileKind          ProfileKind?
  lifecycle            ProfileLifecycle     @default(DRAFT)
  access               ProfileAccess        @default(PRIVATE)
  draftRevision        Int                  @default(0)
  isPrimary            Boolean              @default(false)
  creationKey          String?              @unique
  publishedAt          DateTime?
  archivedAt           DateTime?
  profession           ProfessionType       @default(PERSONAL)
  customProfession     String?
  primaryLanguage      String               @default("ar")
  firstName            String?
  lastName             String?
  displayNameAr        String?
  displayNameEn        String?
  title                String?
  jobTitleAr           String?
  jobTitleEn           String?
  company              String?
  bio                  String?
  bioAr                String?
  bioEn                String?
  organizationNameAr   String?
  organizationNameEn   String?
  industryAr           String?
  industryEn           String?
  descriptionAr        String?
  descriptionEn        String?
  avatarUrl            String?
  avatarStorageKey     String?
  coverUrl             String?
  coverStorageKey      String?
  logoUrl              String?
  logoStorageKey       String?
  phone                String?
  alternatePhone       String?
  whatsappBusiness     String?
  whatsappPrivate      String?
  email                String?
  website              String?
  facebook             String?
  linkedin             String?
  github               String?
  tiktok               String?
  vcfUrl               String?
  locationText         String?
  addressAr            String?
  addressEn            String?
  contactNotesAr       String?
  contactNotesEn       String?
  isPublic             Boolean              @default(true)
  theme                ProfileTheme         @default(CLASSIC_DARK)
  avatarCrop           Json?
  coverCrop            Json?
  showAvatar           Boolean              @default(true)
  showCover            Boolean              @default(true)
  showDisplayName      Boolean              @default(true)
  showTitle            Boolean              @default(true)
  showBio              Boolean              @default(true)
  showPhone            Boolean              @default(true)
  showEmail            Boolean              @default(true)
  showWebsite          Boolean              @default(true)
  showLocation         Boolean              @default(true)
  showWhatsappBusiness Boolean              @default(true)
  showWhatsappPrivate  Boolean              @default(true)
  showSocialLinks      Boolean              @default(true)
  showCustomFields     Boolean              @default(true)
  showUploadedFiles    Boolean              @default(true)
  showSaveContact      Boolean              @default(true)
  allowInstallable     Boolean              @default(false)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization         Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  category             ProfileCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  template             ProfileTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  destinations         Destination[]
  tags                 Tag[]
  cards                Card[]
  fields               ProfileField[]
  uploads              UploadedFile[]
  services             ProfileService[]
  branches             ProfileBranch[]
  virtualCard          VirtualCard?
  modules              ProfileModule[]
  entitlementGrants    ProfileEntitlement[] @relation("ProfileEntitlementProfile")
  onboardingProgress   OnboardingProgress?
  publication          ProfilePublication?
  revisions            ProfileRevision[]
  slugHistory          ProfileSlugHistory[]
  mediaAssets          ProfileMediaAsset[]
  selectedForFriends   FriendsPreference[]  @relation("FriendsSocialProfile")
  friendReports        UserReport[]         @relation("UserReportProfile")

  @@index([userId])
