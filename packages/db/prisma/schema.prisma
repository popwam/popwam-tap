  sortOrder      Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments    ContentAttachment[]
  publications   ContentPublication[]

  @@unique([userId, normalizedName])
  @@index([userId, visibility, sortOrder])
}

model ContentAttachment {
  id             String       @id @default(cuid())
  contentEntryId String
  uploadedFileId String
  sortOrder      Int          @default(0)
  contentEntry   ContentEntry @relation(fields: [contentEntryId], references: [id], onDelete: Cascade)
  uploadedFile   UploadedFile @relation(fields: [uploadedFileId], references: [id], onDelete: Restrict)

  @@unique([contentEntryId, uploadedFileId])
}

model ContentPublication {
  id             String       @id @default(cuid())
  contentEntryId String
  virtualCardId  String
  isVisible      Boolean      @default(true)
  sortOrder      Int          @default(0)
  contentEntry   ContentEntry @relation(fields: [contentEntryId], references: [id], onDelete: Cascade)
  virtualCard    VirtualCard  @relation(fields: [virtualCardId], references: [id], onDelete: Cascade)

  @@unique([contentEntryId, virtualCardId])
  @@index([virtualCardId, isVisible, sortOrder])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
}

model UserBlock {
  id             String              @id @default(cuid())
  ownerId        String
  blockedId      String
  reason         String?
  reasonCategory UserReportCategory?
  source         UserBlockSource     @default(FRIENDS)
  createdAt      DateTime            @default(now())
  owner          User                @relation("UserBlockOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  blocked        User                @relation("UserBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([ownerId, blockedId])
  @@index([ownerId, createdAt])
  @@index([blockedId])
}

model UserReport {
  id              String              @id @default(cuid())
  reporterId      String
  subjectId       String?
  targetProfileId String?
  reason          String
  category        UserReportCategory?
  source          UserReportSource    @default(FRIENDS)
  details         String?
  status          UserReportStatus    @default(OPEN)
  reviewedById    String?
  reviewedAt      DateTime?
  reviewNote      String?
  resolutionCode  String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  reporter        User                @relation("UserReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  subject         User?               @relation("UserReportSubject", fields: [subjectId], references: [id], onDelete: SetNull)
  targetProfile   Profile?            @relation("UserReportProfile", fields: [targetProfileId], references: [id], onDelete: SetNull)
  reviewedBy      User?               @relation("UserReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([subjectId])
  @@index([reporterId, subjectId, createdAt])
  @@index([targetProfileId, createdAt])
}

model NearbyPreference {
  id            String    @id @default(cuid())
  userId        String    @unique
  enabled       Boolean   @default(false)
  discoverable  Boolean   @default(false)
  generation    Int       @default(0)
  activatedAt   DateTime?
  disabledAt    DateTime?
  visibleUntil  DateTime?
  virtualCardId String?
  audience      String    @default("EVERYONE_OPTED_IN")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([enabled, discoverable, updatedAt])
  @@index([enabled, visibleUntil])
}

model NearbyPresence {
  id                  String               @id @default(cuid())
  userId              String               @unique
  coarseCell          String
  cellVersion         Int                  @default(1)
  generation          Int
  sessionHash         String               @unique
  source              NearbyPresenceSource
  cellWindowStartedAt DateTime
  cellChangesInWindow Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  expiresAt           DateTime
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([coarseCell, expiresAt])
  @@index([expiresAt])
}

model NearbyRateLimitBucket {
  id          String              @id @default(cuid())
  userId      String
  kind        NearbyRateLimitKind
  windowStart DateTime
  count       Int                 @default(0)
  updatedAt   DateTime            @updatedAt
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@index([kind, windowStart])
}

model DeviceSession {
  id                  String                   @id @default(cuid())
  userId              String
  tokenFamilyHash     String                   @unique
  deviceType          LogicalDeviceType        @default(MOBILE_APP)
  deviceName          String?
  userLabel           String?
  platform            String
  browserName         String?
  appName             String?
  appVersion          String?
  authMethod          SessionAuthMethod        @default(LEGACY)
  lastSeenAt          DateTime                 @default(now())
  lastAuthenticatedAt DateTime?
  revokedAt           DateTime?
  createdAt           DateTime                 @default(now())
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  webSessions         Session[]
  mobileRefreshTokens MobileRefreshToken[]
  pushTokens          DevicePushToken[]
  passkeys            PasskeyCredential[]
  stepUpGrants        StepUpGrant[]
  deviceCredentials   MobileDeviceCredential[]

  @@index([userId, revokedAt, lastSeenAt])
  @@index([userId, deviceType, revokedAt])
}

model UserPreference {
  id        String                 @id @default(cuid())
  userId    String                 @unique
  theme     UserThemePreference    @default(SYSTEM)
  language  UserLanguagePreference @default(SYSTEM)
  font      UserFontPreference     @default(DEFAULT)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  id               String   @id @default(cuid())
  userId           String   @unique
  generalEnabled   Boolean  @default(true)
  securityEnabled  Boolean  @default(true)
  productsEnabled  Boolean  @default(true)
  socialEnabled    Boolean  @default(true)
  marketingEnabled Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FriendNotificationEvent {
  id              String                   @id @default(cuid())
  recipientUserId String
  actorUserId     String?
  requestId       String?
  type            FriendNotificationType
  status          FriendNotificationStatus @default(PENDING)
  createdAt       DateTime                 @default(now())
  availableAt     DateTime                 @default(now())
  sentAt          DateTime?
  recipient       User                     @relation("FriendNotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  actor           User?                    @relation("FriendNotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  request         FriendRequest?           @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([recipientUserId, status, createdAt])
  @@index([status, availableAt])
  @@index([actorUserId, recipientUserId, createdAt])
}

model StepUpGrant {
  id                 String         @id @default(cuid())
  tokenHash          String         @unique
  userId             String
  deviceSessionId    String?
  webSessionId       String?
  purpose            StepUpPurpose
  method             StepUpMethod
  assuranceLevel     Int            @default(2)
  sessionBindingHash String
  issuedAt           DateTime       @default(now())
  expiresAt          DateTime
  consumedAt         DateTime?
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceSession      DeviceSession? @relation(fields: [deviceSessionId], references: [id], onDelete: Cascade)
  webSession         Session?       @relation(fields: [webSessionId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@index([deviceSessionId, expiresAt])
  @@index([webSessionId, expiresAt])
}

model AccountDeletionRequest {
  id          String                       @id @default(cuid())
  userId      String
  status      AccountDeletionRequestStatus @default(REQUESTED)
  requestedAt DateTime                     @default(now())
  reviewedAt  DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  user        User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, requestedAt])
}

model ProductStatusHistory {
  id         String      @id @default(cuid())
  cardId     String
  fromStatus CardStatus?
  toStatus   CardStatus
  actorId    String?
  reason     String?
  createdAt  DateTime    @default(now())
  card       Card        @relation(fields: [cardId], references: [id], onDelete: Cascade)
  actor      User?       @relation("ProductStatusActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([cardId, createdAt])
}

model WalletPass {
  id               String           @id @default(cuid())
  virtualCardId    String
  platform         WalletPlatform
  externalObjectId String?
  serialNumber     String           @unique
  status           WalletPassStatus @default(PENDING)
  lastGeneratedAt  DateTime?
  lastUpdatedAt    DateTime?
  createdAt        DateTime         @default(now())
  virtualCard      VirtualCard      @relation(fields: [virtualCardId], references: [id], onDelete: Cascade)

  @@unique([virtualCardId, platform])
  @@index([platform, status])
}

model TagTransfer {
  id           String            @id @default(cuid())
  tagId        String
  fromUserId   String
  toUserId     String?
  invitedEmail String?
  status       TagTransferStatus @default(PENDING)
  expiresAt    DateTime
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  tag          Card              @relation(fields: [tagId], references: [id], onDelete: Restrict)
  fromUser     User              @relation("TagTransferFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser       User?             @relation("TagTransferTo", fields: [toUserId], references: [id], onDelete: SetNull)

  @@index([fromUserId, status])
  @@index([toUserId, status])
  @@index([invitedEmail, status])
  @@index([tagId, status])
}

model ProfileTemplate {
  id                    String                  @id @default(cuid())
  nameAr                String
  nameEn                String
  slug                  String                  @unique
  category              String
  categoryId            String?
  profileKind           ProfileKind?
  minimumPlan           String
  previewImageUrl       String?
  configuration         Json
  isActive              Boolean                 @default(true)
  sortOrder             Int                     @default(0)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  virtualCards          VirtualCard[]
  categoryRef           ProfileCategory?        @relation("ProfileTemplateCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  defaultForCategories  ProfileCategory[]       @relation("ProfileCategoryDefaultTemplate")
  profiles              Profile[]
  moduleRules           ProfileTemplateModule[]
  onboardingDefinitions OnboardingDefinition[]

  @@index([isActive, sortOrder])
  @@index([minimumPlan])
  @@index([categoryId, profileKind, isActive])
}

model OnboardingProgress {
  id                String                @id @default(cuid())
  userId            String                @unique
  profileId         String?               @unique
  definitionId      String?
  definitionVersion Int?
  currentStep       Int                   @default(1)
  currentStepKey    String?
  revision          Int                   @default(0)
  draftAnswers      Json                  @default("{}")
  initialAnswers    Json                  @default("{}")
  completedAt       DateTime?
  data              Json                  @default("{}")
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile           Profile?              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  definition        OnboardingDefinition? @relation(fields: [definitionId], references: [id], onDelete: Restrict)

  @@index([definitionId, definitionVersion])
  @@index([profileId, completedAt])
}

model OnboardingDefinition {
  id          String                     @id @default(cuid())
  key         String
  version     Int
  profileKind ProfileKind
  categoryId  String?
  templateId  String?
  status      OnboardingDefinitionStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  category    ProfileCategory?           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  template    ProfileTemplate?           @relation(fields: [templateId], references: [id], onDelete: Restrict)
  steps       OnboardingStep[]
  progress    OnboardingProgress[]

  @@unique([key, version])
  @@index([profileKind, status, version])
  @@index([categoryId, status, version])
  @@index([templateId, status, version])
}

model OnboardingStep {
  id                 String                   @id @default(cuid())
  definitionId       String
  key                String
  sortOrder          Int
  titleEn            String
  titleAr            String
  descriptionEn      String?
  descriptionAr      String?
  stepType           OnboardingStepType       @default(FORM)
  required           Boolean                  @default(true)
  moduleDefinitionId String?
  active             Boolean                  @default(true)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  definition         OnboardingDefinition     @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  moduleDefinition   ProfileModuleDefinition? @relation(fields: [moduleDefinitionId], references: [id], onDelete: Restrict)
  questions          OnboardingQuestion[]

  @@unique([definitionId, key])
  @@index([definitionId, active, sortOrder])
  @@index([moduleDefinitionId])
}

model OnboardingQuestion {
  id           String                        @id @default(cuid())
  stepId       String
  key          String
  questionType OnboardingQuestionType
  labelEn      String
  labelAr      String
  helpEn       String?
  helpAr       String?
  required     Boolean                       @default(false)
  sortOrder    Int
  mappingKey   OnboardingMappingKey
  minLength    Int?
  maxLength    Int?
  minValue     Decimal?                      @db.Decimal(14, 2)
  maxValue     Decimal?                      @db.Decimal(14, 2)
  maxItems     Int?
  active       Boolean                       @default(true)
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt
  step         OnboardingStep                @relation(fields: [stepId], references: [id], onDelete: Cascade)
  options      OnboardingQuestionOption[]
  conditions   OnboardingQuestionCondition[]

  @@unique([stepId, key])
  @@index([stepId, active, sortOrder])
}

model OnboardingQuestionOption {
  id         String             @id @default(cuid())
  questionId String
  key        String
  labelEn    String
  labelAr    String
  sortOrder  Int                @default(0)
  active     Boolean            @default(true)
  question   OnboardingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, key])
  @@index([questionId, active, sortOrder])
}

model OnboardingQuestionCondition {
  id                String                      @id @default(cuid())
  questionId        String
  sourceQuestionKey String
  operator          OnboardingConditionOperator
  expectedValues    String[]
  question          OnboardingQuestion          @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model InventoryBatch {
  id                String        @id @default(cuid())
  productId         String
  batchCode         String        @unique
  producedQuantity  Int
  availableQuantity Int
  assignedQuantity  Int           @default(0)
  damagedQuantity   Int           @default(0)
  unitCost          Decimal       @db.Decimal(14, 2)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  product           InventoryItem @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
}

model InventoryMovement {
  id              String                @id @default(cuid())
  inventoryItemId String
  type            InventoryMovementType
  quantity        Int
  unitCost        Decimal?              @db.Decimal(14, 2)
  referenceType   String?
  referenceId     String?
  notes           String?
  createdBy       String
  createdAt       DateTime              @default(now())
  inventoryItem   InventoryItem         @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  creator         User                  @relation("InventoryMovementCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([inventoryItemId, createdAt])
  @@index([referenceType, referenceId])
}

model Purchase {
  id            String         @id @default(cuid())
  supplierId    String
  invoiceNumber String?
  status        PurchaseStatus @default(DRAFT)
  subtotal      Decimal        @default(0) @db.Decimal(14, 2)
  shippingCost  Decimal        @default(0) @db.Decimal(14, 2)
  customsCost   Decimal        @default(0) @db.Decimal(14, 2)
  otherCost     Decimal        @default(0) @db.Decimal(14, 2)
  totalCost     Decimal        @default(0) @db.Decimal(14, 2)
  paidAmount    Decimal        @default(0) @db.Decimal(14, 2)
  purchaseDate  DateTime
  receivedDate  DateTime?
  notes         String?
  createdBy     String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  supplier      Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  creator       User           @relation("PurchaseCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  items         PurchaseItem[]

  @@index([supplierId, purchaseDate])
  @@index([status])
}

model PurchaseItem {
  id              String        @id @default(cuid())
  purchaseId      String
  inventoryItemId String
  quantity        Int
  unitCost        Decimal       @db.Decimal(14, 2)
  totalCost       Decimal       @db.Decimal(14, 2)
  purchase        Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@index([inventoryItemId])
}

model ExpenseCategory {
  id       String    @id @default(cuid())
  nameAr   String
  nameEn   String
  isActive Boolean   @default(true)
  expenses Expense[]
}

model Expense {
  id               String          @id @default(cuid())
  categoryId       String
  title            String
  description      String?
  amount           Decimal         @db.Decimal(14, 2)
  expenseDate      DateTime
  paymentMethod    String?
  referenceNumber  String?
  attachmentFileId String?
  createdBy        String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  category         ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  attachment       UploadedFile?   @relation(fields: [attachmentFileId], references: [id], onDelete: SetNull)
  creator          User            @relation("ExpenseCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([categoryId, expenseDate])
}

model Customer {
  id               String   @id @default(cuid())
  userId           String?  @unique
  name             String
  phone            String?
  email            String?
  organizationName String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders           Order[]

  @@index([phone])
}

model Order {
  id            String        @id @default(cuid())
  customerId    String
  status        OrderStatus   @default(DRAFT)
  subtotal      Decimal       @default(0) @db.Decimal(14, 2)
  discount      Decimal       @default(0) @db.Decimal(14, 2)
  shippingCost  Decimal       @default(0) @db.Decimal(14, 2)
  total         Decimal       @default(0) @db.Decimal(14, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(14, 2)
  paymentStatus PaymentStatus @default(UNPAID)
  notes         String?
  createdBy     String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  creator       User          @relation("OrderCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  items         OrderItem[]

  @@index([customerId, createdAt])
  @@index([status, paymentStatus])
}

model OrderItem {
  id              String         @id @default(cuid())
  orderId         String
  cardId          String?
  inventoryItemId String?
  description     String
  quantity        Int
  unitPrice       Decimal        @db.Decimal(14, 2)
  total           Decimal        @db.Decimal(14, 2)
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  card            Card?          @relation(fields: [cardId], references: [id], onDelete: SetNull)
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([cardId])
}

model SystemSetting {
